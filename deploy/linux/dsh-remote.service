[Unit]
Description=dsh-remote gateway (auth + workspace + static client)
Documentation=https://github.com/skyblade47/dsh-remote
After=network-online.target dsh-kernel.service
Wants=network-online.target dsh-kernel.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_USER__
Environment=PATH=__NPM_GLOBAL_BIN__:/usr/local/bin:/usr/local/sbin:/usr/bin:/bin
Environment=NODE_ENV=production
EnvironmentFile=-/etc/dsh-remote.env
ExecStart=/usr/bin/env node __REPO_ROOT__/server/gateway/src/index.js
WorkingDirectory=__REPO_ROOT__
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
